generator client {
  provider = "prisma-client-js"
  // `driverAdapters` (preview) foi removido: não era usado no runtime Node
  // (lib/prisma usa Accelerate em prod e conexão direta em dev local) e forçava
  // a geração pela via wasm/queryCompiler, que falhava por arquivo ausente
  // (`query_engine_bg.postgresql.wasm-base64.js`). Sem ele, o client usa o
  // engine de biblioteca (binário) normalmente.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// AUTH & ORGANIZATION
// =====================================================

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Dono/titular da organização — único privilegiado que pode transferir a
  // titularidade. Não pode ser rebaixado ou desativado por terceiros. Nullable
  // durante migration; backfill seta o ADMIN mais antigo de cada org.
  ownerId String? @unique
  owner   User?   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  users          User[]
  clients        Client[]
  invitations    Invitation[]
  auditLogs      AuditLog[]
  calendarEvents CalendarEvent[]
  holidays       OrgHoliday[]

  @@index([slug])
}

enum UserRole {
  ADMIN
  STAFF
  CLIENT_OWNER
  CLIENT_STAFF
}

// Como atividades viram eventos no calendário pessoal do usuário.
// ASK é o default — mostra checkbox "Adicionar ao calendário" na criação.
enum ActivityCalendarSync {
  AUTO
  ASK
  NEVER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          UserRole
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  permissions         UserPermission[]
  sessions            Session[]
  accounts            Account[]
  activities          Activity[]           @relation("AssignedActivities")
  createdActivities   Activity[]           @relation("CreatedActivities")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  calendarEvents      CalendarEvent[]

  // Inverso 1:1 de Organization.ownerId — null se este usuário não é dono.
  ownedOrganization Organization? @relation("OrganizationOwner")

  // Preferência de quando atividades criadas viram evento no calendário do
  // usuário. ASK = checkbox aparece na criação (default).
  activityCalendarSync ActivityCalendarSync @default(ASK)

  @@index([organizationId])
  @@index([clientId])
  @@index([email])
}

model UserPermission {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String
  canRead   Boolean @default(true)
  canWrite  Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([userId, module])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id             String    @id @default(cuid())
  email          String
  role           UserRole
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id])
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime  @default(now())

  @@index([token])
  @@index([email])
}

/// Tokens de recuperação de senha. Armazenamos apenas o hash (sha256) do
/// token; o token cru só existe na URL enviada por email — não em logs nem
/// no banco. Uso único: `usedAt` é setado ao consumir; verificação rejeita
/// tokens expirados ou já utilizados.
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// =====================================================
// CLIENT (CLÍNICA)
// =====================================================

enum ClientStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
  CHURNED
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name          String
  slug          String
  city          String?
  state         String?
  phone         String?
  email         String?
  status        ClientStatus @default(ONBOARDING)
  monthlyFee    Decimal?     @db.Decimal(12, 2)
  contractStart DateTime?
  notes         String?      @db.Text

  healthScore    Int?
  lastSnapshotAt DateTime?

  // Configuração de expediente
  workdayStart String @default("07:00") // "HH:MM"
  workdayEnd   String @default("20:00") // "HH:MM"
  workdays     String @default("1,2,3,4,5,6") // CSV: 0=Dom … 6=Sáb

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users                User[]
  invitations          Invitation[]
  leads                Lead[]
  patients             Patient[]
  procedures           Procedure[]
  procedureCategories  ProcedureCategory[]
  revenues             Revenue[]
  revenueProcedures    RevenueProcedure[]
  costs                Cost[]
  appointments         Appointment[]
  activities           Activity[]
  insights             Insight[]
  goals                Goal[]
  pipelineStages       PipelineStage[]
  marketingCampaigns   MarketingCampaign[]
  kpiSnapshots         KpiSnapshot[]
  pipelineDeals        PipelineDeal[]
  holidays             ClinicHoliday[]
  calendarEvents       CalendarEvent[]
  notifications        Notification[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
}

model ClinicHoliday {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  name      String
  createdAt DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId])
}

// =====================================================
// PIPELINE INTERNO DA CLÍNICA
// =====================================================

enum StageKind {
  NEW // funil de clientes novos (leads)
  EXISTING // funil de clientes já cadastrados (pacientes)
}

model PipelineStage {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  name      String
  // Cada clínica tem dois funis independentes (NEW vs EXISTING); `order` é
  // único dentro de cada funil, não entre eles.
  kind      StageKind @default(NEW)
  order     Int
  color     String?
  isWon     Boolean   @default(false)
  isLost    Boolean   @default(false)
  createdAt DateTime  @default(now())

  leads Lead[]

  @@unique([clientId, kind, order])
  @@index([clientId, kind])
}

enum LeadSource {
  META_ADS
  GOOGLE_ADS
  ORGANIC
  REFERRAL
  WHATSAPP
  WALK_IN
  OTHER
}

model MarketingCampaign {
  id        String     @id @default(cuid())
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id])
  name      String
  source    LeadSource
  budget    Decimal?   @db.Decimal(12, 2)
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean    @default(true)
  notes     String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  leads Lead[]
  costs Cost[]

  @@index([clientId, isActive])
}

model Lead {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])

  name              String
  phone             String?
  email             String?
  source            LeadSource
  campaignId        String?
  campaign          MarketingCampaign? @relation(fields: [campaignId], references: [id])
  procedureInterest String?
  notes             String?    @db.Text

  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id])
  // Posição manual dentro da coluna. Float fracionário permite inserir entre
  // dois cards sem renumerar (1.0 → 1.5 → 2.0). Mesmo padrão do PipelineDeal.
  position Float @default(0)

  firstContactAt DateTime?
  scheduledAt    DateTime?
  attendedAt     DateTime?
  closedAt       DateTime?
  lostAt         DateTime?
  lostReason     String?

  patientId      String?
  patient        Patient?  @relation(fields: [patientId], references: [id])
  estimatedValue Decimal?  @db.Decimal(12, 2)

  assignedToId String?
  tags         String[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  interactions LeadInteraction[]

  @@index([organizationId, clientId])
  @@index([clientId, stageId, deletedAt])
  @@index([clientId, stageId, position])
  @@index([clientId, source])
  @@index([clientId, createdAt])
}

model LeadInteraction {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String
  content     String   @db.Text
  metadata    Json?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([leadId, createdAt])
}

// =====================================================
// PACIENTES
// =====================================================

model Patient {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])

  name        String
  phone       String?
  email       String?
  birthDate   DateTime?
  cpf         String?
  notes       String?   @db.Text
  tags        String[]

  firstVisitAt DateTime?
  lastVisitAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  leads        Lead[]
  appointments Appointment[]
  revenues     Revenue[]

  @@index([organizationId, clientId])
  @@index([clientId, deletedAt])
}

// =====================================================
// PROCEDIMENTOS
// =====================================================

model ProcedureCategory {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  name      String
  color     String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  procedures Procedure[]

  @@unique([clientId, name])
  @@index([clientId])
}

model Procedure {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  categoryId     String?
  category       ProcedureCategory? @relation(fields: [categoryId], references: [id])

  name            String
  description     String?  @db.Text
  price           Decimal  @db.Decimal(12, 2)
  cost            Decimal  @db.Decimal(12, 2)
  durationMinutes Int?
  isActive        Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  appointments      Appointment[]
  revenues          Revenue[]
  revenueProcedures RevenueProcedure[]

  @@index([organizationId, clientId])
  @@index([clientId, isActive])
}

// =====================================================
// AGENDAMENTOS
// =====================================================

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELED
  RESCHEDULED
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  clientId       String
  client         Client            @relation(fields: [clientId], references: [id])
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id])
  procedureId    String
  procedure      Procedure         @relation(fields: [procedureId], references: [id])

  scheduledAt     DateTime
  durationMinutes Int
  status          AppointmentStatus @default(SCHEDULED)
  confirmedAt     DateTime?
  attendedAt      DateTime?
  noShowAt        DateTime?
  canceledAt      DateTime?
  cancelReason    String?

  notes String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  revenue Revenue?

  @@index([organizationId, clientId])
  @@index([clientId, scheduledAt])
  @@index([clientId, status])
}

// =====================================================
// FINANCEIRO
// =====================================================

enum CostType {
  FIXED
  VARIABLE
  MARKETING
  PAYROLL
  TAX
  OTHER
}

model Revenue {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  patientId      String?
  patient        Patient?  @relation(fields: [patientId], references: [id])
  procedureId    String?
  procedure      Procedure? @relation(fields: [procedureId], references: [id])
  appointmentId  String?    @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])

  amount        Decimal @db.Decimal(12, 2)
  date          DateTime
  description   String?
  paymentMethod String?
  installments  Int?    @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  procedures RevenueProcedure[]
  costs      Cost[]

  @@index([organizationId, clientId])
  @@index([clientId, date])
}

// Itens de procedimento de uma receita. Permite múltiplos procedimentos por
// receita; `price`/`cost` são snapshots no momento do lançamento.
model RevenueProcedure {
  id          String    @id @default(cuid())
  // clientId presente p/ a policy de RLS tenant_isolation (filtra por clientId).
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  revenueId   String
  revenue     Revenue   @relation(fields: [revenueId], references: [id], onDelete: Cascade)
  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id])

  price Decimal @db.Decimal(12, 2)
  cost  Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([revenueId])
  @@index([procedureId])
  @@index([clientId])
}

model Cost {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  campaignId     String?
  campaign       MarketingCampaign? @relation(fields: [campaignId], references: [id])
  // Custo gerado automaticamente a partir de um procedimento de receita.
  revenueId      String?
  revenue        Revenue?  @relation(fields: [revenueId], references: [id], onDelete: SetNull)

  type         CostType
  category     String?
  amount       Decimal  @db.Decimal(12, 2)
  date         DateTime
  description  String?
  isRecurring  Boolean  @default(false)
  recurringDay Int?

  // Self-relation: instances generated from a recurring template point back to it.
  // null on templates and on standalone costs; set on auto-generated children.
  recurringSourceId  String?
  recurringSource    Cost?    @relation("RecurringInstances", fields: [recurringSourceId], references: [id], onDelete: SetNull)
  recurringInstances Cost[]   @relation("RecurringInstances")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  @@index([organizationId, clientId])
  @@index([clientId, date])
  @@index([clientId, type])
  @@index([recurringSourceId, date])
  @@index([revenueId])
}

// =====================================================
// METAS
// =====================================================

enum GoalMetric {
  REVENUE
  LEADS
  CONVERSION_RATE
  NO_SHOW_RATE
  AVERAGE_TICKET
  APPOINTMENTS
  NEW_PATIENTS
}

enum GoalPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

model Goal {
  id             String     @id @default(cuid())
  organizationId String
  clientId       String
  client         Client     @relation(fields: [clientId], references: [id])

  metric      GoalMetric
  period      GoalPeriod
  targetValue Decimal    @db.Decimal(15, 2)
  startDate   DateTime
  endDate     DateTime
  notes       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId, metric, period])
}

// =====================================================
// INSIGHTS
// =====================================================

enum InsightSeverity {
  INFO
  WARNING
  CRITICAL
}

enum InsightCategory {
  COMMERCIAL
  FINANCIAL
  OPERATIONAL
  RETENTION
  MARKETING
}

enum InsightStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model Insight {
  id             String          @id @default(cuid())
  organizationId String
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id])

  ruleKey         String
  category        InsightCategory
  severity        InsightSeverity
  status          InsightStatus   @default(OPEN)

  title           String
  diagnosis       String   @db.Text
  estimatedImpact Decimal? @db.Decimal(12, 2)
  suggestion      String   @db.Text
  metadata        Json?

  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  dismissedAt    DateTime?
  dismissReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([clientId, severity])
  @@index([clientId, createdAt])
}

// =====================================================
// ATIVIDADES E TAREFAS
// =====================================================

// Domínio dono da atividade (reforma divisão total). ADMIN = atividade da
// agência (pode ter clientId só como ETIQUETA de CRM, "relacionada à clínica
// X"). CLINIC = atividade operacional criada pela própria clínica (clientId =
// dono). O discriminador impede que a tarefa da clínica apareça no painel do
// admin e vice-versa — clientId sozinho não distingue os dois usos.
enum ActivityDomain {
  ADMIN
  CLINIC
}

enum ActivityType {
  TASK
  MEETING
  CALL
  EMAIL
  NOTE
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Activity {
  id             String           @id @default(cuid())
  organizationId String
  clientId       String?
  client         Client?          @relation(fields: [clientId], references: [id])
  // ADMIN por padrão (toda atividade existente é da agência). Clínica grava
  // CLINIC. Queries de cada domínio filtram por este campo — ver §3.4.
  domain         ActivityDomain   @default(ADMIN)

  title       String
  description String?          @db.Text
  type        ActivityType
  status      ActivityStatus   @default(PENDING)
  priority    ActivityPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?

  assignedToId String?
  assignedTo   User?   @relation("AssignedActivities", fields: [assignedToId], references: [id])

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?
  createdBy        User?     @relation("CreatedActivities", fields: [createdById], references: [id])
  seenByAssigneeAt DateTime?
  // Id compartilhado por todas as cópias geradas em um fan-out "Todos".
  // Usado pelo admin para colapsar as N cópias em uma única linha na pasta
  // "Todos" (mostra apenas a cópia do próprio admin).
  broadcastId      String?
  deletedAt        DateTime?

  // Evento ligado no calendário pessoal do responsável — quando a atividade
  // é criada com "Adicionar ao calendário". Edit/delete da atividade
  // sincroniza com o evento (handled na camada de actions).
  calendarEvent    CalendarEvent?

  @@index([organizationId, status])
  @@index([assignedToId, status])
  @@index([dueDate])
  @@index([organizationId, status, dueDate])
  // Domínio clínica: queries escopam por clientId. Cobre where+orderBy reais
  // das listagens de atividade da clínica (Fase 3 da reforma divisão total).
  @@index([clientId, status, dueDate])
  @@index([broadcastId])
}

// =====================================================
// CALENDÁRIO PESSOAL (por usuário)
// =====================================================

model CalendarEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  // Escopo de domínio (reforma divisão total, Fase 1). Evento da clínica recebe
  // o clientId do dono; evento de agência fica null. Derivar domínio:
  // clientId != null ⇒ clínica. Garantido por ClinicContext na camada de dados.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  title    String
  startAt  DateTime
  endAt    DateTime?
  notes    String?  @db.Text
  // Opcionais: cor (hex) e categoria livre (ex.: "Pessoal", "Reunião") para
  // visualização. Não afetam o filtro/permissão.
  color    String?
  category String?

  // Atividade que originou esse evento (sync 1:1). null para eventos criados
  // direto no calendário. Edit/delete da atividade propaga via actions.
  activityId String?   @unique
  activity   Activity? @relation(fields: [activityId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, startAt])
  @@index([organizationId, deletedAt])
  @@index([clientId, startAt])
}

model OrgHoliday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  date           String       // YYYY-MM-DD (sem TZ — feriado é dia inteiro)
  name           String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, date])
  @@index([organizationId])
}

// =====================================================
// PIPELINE DO ADMIN
// =====================================================

enum DealStage {
  PROSPECT
  CONTACTED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

model PipelineDeal {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])

  stage           DealStage @default(PROSPECT)
  // Posição manual dentro da coluna. Usa Float fracionário para permitir
  // inserir entre dois cards sem renumerar tudo (ex.: entre 1.0 e 2.0 → 1.5).
  position        Float     @default(0)
  value           Decimal?  @db.Decimal(12, 2)
  probability     Int?
  expectedCloseAt DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  lostReason      String?
  notes           String?   @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Uma única negociação ativa por clínica é garantida via índice único
  // parcial (`WHERE "deletedAt" IS NULL`) criado em migration — Prisma não
  // expressa partial unique no DSL. Soft-deletes da mesma clínica podem
  // coexistir; o app-level check em createPipelineDealAction valida o resto.
  @@index([organizationId, stage])
  @@index([organizationId, stage, position])
}

// =====================================================
// SNAPSHOTS DE KPI
// =====================================================

model KpiSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])

  periodType  String
  periodStart DateTime
  periodEnd   DateTime

  leadsCount        Int     @default(0)
  appointmentsCount Int     @default(0)
  attendedCount     Int     @default(0)
  noShowCount       Int     @default(0)
  conversionRate    Decimal? @db.Decimal(5, 4)
  noShowRate        Decimal? @db.Decimal(5, 4)
  avgTimeToFirstContact Int?

  totalRevenue  Decimal  @default(0) @db.Decimal(15, 2)
  totalCosts    Decimal  @default(0) @db.Decimal(15, 2)
  grossMargin   Decimal? @db.Decimal(5, 4)
  netMargin     Decimal? @db.Decimal(5, 4)
  averageTicket Decimal? @db.Decimal(12, 2)
  marketingCost Decimal  @default(0) @db.Decimal(15, 2)
  roi           Decimal? @db.Decimal(8, 4)
  cac           Decimal? @db.Decimal(12, 2)

  healthScore Int?

  computedAt DateTime @default(now())

  @@unique([clientId, periodType, periodStart])
  @@index([organizationId, periodType, periodStart])
}

// =====================================================
// NOTIFICAÇÕES
// =====================================================

enum NotificationType {
  INSIGHT_GENERATED
  GOAL_AT_RISK
  GOAL_ACHIEVED
  ACTIVITY_DUE
  ACTIVITY_OVERDUE
  CLIENT_INACTIVE
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Escopo de domínio (reforma divisão total, Fase 1). Preenchido quando o
  // destinatário é de clínica (= User.clientId do destinatário); null para
  // notificação de agência. Derivar domínio: clientId != null ⇒ clínica.
  clientId  String?
  client    Client?          @relation(fields: [clientId], references: [id])
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([clientId, readAt])
}

// =====================================================
// AUDIT LOG
// =====================================================

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  action         String
  entityType     String
  entityId       String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}
