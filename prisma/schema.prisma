generator client {
  provider = "prisma-client-js"
  // `driverAdapters` (preview) foi removido: não era usado no runtime Node
  // (lib/prisma usa Accelerate em prod e conexão direta em dev local) e forçava
  // a geração pela via wasm/queryCompiler, que falhava por arquivo ausente
  // (`query_engine_bg.postgresql.wasm-base64.js`). Sem ele, o client usa o
  // engine de biblioteca (binário) normalmente.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// AUTH & ORGANIZATION
// =====================================================

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Dono/titular da organização — único privilegiado que pode transferir a
  // titularidade. Não pode ser rebaixado ou desativado por terceiros. Nullable
  // durante migration; backfill seta o ADMIN mais antigo de cada org.
  ownerId String? @unique
  owner   User?   @relation("OrganizationOwner", fields: [ownerId], references: [id])

  users          User[]
  clients        Client[]
  invitations    Invitation[]
  auditLogs      AuditLog[]
  calendarEvents CalendarEvent[]
  holidays       OrgHoliday[]
  agencyRoles    AgencyRole[]

  @@index([slug])
}

enum UserRole {
  ADMIN
  STAFF
  CLIENT_OWNER
  CLIENT_STAFF
}

// Como atividades viram eventos no calendário pessoal do usuário.
// ASK é o default — mostra checkbox "Adicionar ao calendário" na criação.
enum ActivityCalendarSync {
  AUTO
  ASK
  NEVER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          UserRole
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  // Cargo configurável dentro da clínica. Null = sem cargo → DENY-BY-DEFAULT
  // (zero acesso, redirect no gate de rota). O titular da clínica (Client.ownerId)
  // ignora o cargo: tem acesso total como a coroa do admin.
  clinicRoleId String?
  clinicRole   ClinicRole? @relation("UserClinicRole", fields: [clinicRoleId], references: [id])

  // Cargo configurável dentro da agência (domínio admin). Espelha clinicRoleId.
  // Null = sem cargo → deny-by-default. ADMIN titular (Organization.ownerId)
  // ignora o cargo (coroa). Escopo: AgencyRole é por organizationId.
  agencyRoleId String?
  agencyRole   AgencyRole? @relation("UserAgencyRole", fields: [agencyRoleId], references: [id])

  // Inverso 1:1 de Client.ownerId — null se este usuário não é titular da clínica.
  ownedClient Client? @relation("ClientOwner")

  // Metas atribuídas a este usuário (Etapa 2 — escopo USER).
  goalsAssigned Goal[] @relation("GoalAssignee")

  sessions            Session[]
  accounts            Account[]
  activities          Activity[]           @relation("AssignedActivities")
  createdActivities   Activity[]           @relation("CreatedActivities")
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  calendarEvents      CalendarEvent[]
  authoredNotes       ClientNote[]         @relation("AuthoredNotes")
  uploadedDocuments   Document[]           @relation("UploadedDocuments")

  // Inverso 1:1 de Organization.ownerId — null se este usuário não é dono.
  ownedOrganization Organization? @relation("OrganizationOwner")

  // Preferência de quando atividades criadas viram evento no calendário do
  // usuário. ASK = checkbox aparece na criação (default).
  activityCalendarSync ActivityCalendarSync @default(ASK)

  @@index([organizationId])
  @@index([clientId])
  @@index([clinicRoleId])
  @@index([agencyRoleId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  role           UserRole
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  token          String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime     @default(now())

  @@index([token])
  @@index([email])
}

/// Tokens de recuperação de senha. Armazenamos apenas o hash (sha256) do
/// token; o token cru só existe na URL enviada por email — não em logs nem
/// no banco. Uso único: `usedAt` é setado ao consumir; verificação rejeita
/// tokens expirados ou já utilizados.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// =====================================================
// CLIENT (CLÍNICA)
// =====================================================

enum ClientStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
  CHURNED
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name          String
  slug          String
  city          String?
  state         String?
  phone         String?
  email         String?
  status        ClientStatus @default(ONBOARDING)
  monthlyFee    Decimal?     @db.Decimal(12, 2)
  contractStart DateTime?
  notes         String?      @db.Text

  healthScore    Int?
  lastSnapshotAt DateTime?

  // Titular/criador da clínica — espelha Organization.ownerId. Único com acesso
  // total (coroa) e o único que altera dados sensíveis da clínica (nome, email,
  // cidade, telefone, estado) e transfere a titularidade. Nullable durante a
  // migration; backfill seta o CLIENT_OWNER mais antigo de cada clínica.
  ownerId String? @unique
  owner   User?   @relation("ClientOwner", fields: [ownerId], references: [id])

  // Configuração de expediente
  workdayStart String @default("07:00") // "HH:MM"
  workdayEnd   String @default("20:00") // "HH:MM"
  // Dias úteis como Int[] nativo (0=Dom … 6=Sáb). Era CSV; normalizado p/ array
  // (a UI sempre tratou como number[]; só o repo serializava). 1ª NF respeitada.
  workdays     Int[]  @default([1, 2, 3, 4, 5, 6])

  // Dias sem operação/procedimento após os quais um paciente cai p/ INACTIVE na
  // pipeline RETENTION (Fase 2e). Movido pelo cron de retenção.
  inactivityDays Int @default(30)

  // Janela de cancelamento → no-show. Ao arrastar um card para "Cancelado":
  // null (default) = regra do MESMO DIA (cancelar no dia do procedimento conta
  // como no-show; antes do dia = cancelamento, fora da média de no-show). Um Int
  // N = conta como no-show se cancelado dentro de N horas antes do horário; mais
  // cedo = cancelamento. Ver `decideCancellationStatus` em lib/no-show-window.
  noShowWindowHours Int?

  // Regime tributário da clínica (DRE — ledger dre-progresso.md). Define como os
  // impostos entram na DRE: SIMPLES = DAS sobre receita (imposto sobre lucro ~0);
  // PRESUMIDO/REAL separam ISS/PIS/COFINS (sobre receita) de IRPJ/CSLL (sobre lucro).
  taxRegime TaxRegime @default(SIMPLES)
  // Segredo do webhook de ingestão de leads, POR-CLÍNICA (seguranca-pendencias #2).
  // Guarda só o sha256 (hex) de um token de alta entropia; o token cru é mostrado
  // uma única vez ao titular ao gerar/rotacionar. O token resolve o `clientId`
  // server-side no webhook — o body NÃO escolhe mais a clínica (isola cross-tenant).
  webhookTokenHash String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users               User[]
  invitations         Invitation[]
  leads               Lead[]
  patients            Patient[]
  procedures          Procedure[]
  procedureCategories ProcedureCategory[]
  revenues            Revenue[]
  revenueProcedures   RevenueProcedure[]
  costs               Cost[]
  appointments        Appointment[]
  activities          Activity[]
  insights            Insight[]
  goals               Goal[]
  pipelines           Pipeline[]
  pipelineStages      PipelineStage[]
  marketingCampaigns  MarketingCampaign[]
  kpiSnapshots        KpiSnapshot[]
  pipelineDeals       PipelineDeal[]
  holidays            ClinicHoliday[]
  calendarEvents      CalendarEvent[]
  notifications       Notification[]
  clinicRoles         ClinicRole[]
  clientNotes         ClientNote[]
  documents           Document[]
  receivables         Receivable[]
  fixedAssets         FixedAsset[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
}

// Cargo configurável dentro de uma clínica (Etapa 1 — cargos). O dono/titular
// cria cargos e marca permissões por aba do sistema. `permissions` é um JSON
// com uma entrada por módulo:
//   { "financial": { "access": false },                                   // aba bloqueada → some da sidebar + rota redireciona
//     "crm":       { "access": true, "read": true, "write": true, "delete": false },
//     "goals":     { "access": true, "read": true, "write": true, "delete": false, "assignToOthers": true, "viewAll": false },
//     "activities":{ "access": true, "read": true, "write": true, "delete": false, "assignToOthers": false, "viewAll": false } }
// `assignToOthers`/`viewAll` só fazem sentido nas abas relevantes (goals,
// activities). O cargo `isSystem` ("Titular") não é editável nem deletável.
model ClinicRole {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name           String
  permissions    Json
  canManageRoles Boolean @default(false)
  isSystem       Boolean @default(false)

  // Hierarquia LINEAR (deny-by-default + delegação). Menor level = mais alto.
  // Quem gerencia cargos só atua sobre cargos de level estritamente MAIOR que o
  // seu. O titular (coroa) está acima de tudo e ordena os cargos. Único por
  // clínica. isSystem "Titular" = level 0.
  level Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[] @relation("UserClinicRole")
  goals Goal[] @relation("GoalRoleAssignee")

  @@unique([clientId, name])
  @@unique([clientId, level])
  @@index([clientId])
}

// Cargo configurável da AGÊNCIA (domínio admin). Espelho isolado de ClinicRole
// (Isolamento Total / D1 do ledger agency-roles): mesma forma de JSON de
// permissões, escopado por organizationId. NÃO tem cargo de sistema "Titular" —
// a coroa da agência é Organization.ownerId + role ADMIN, que ignora o cargo.
// `permissions` Json segue o mesmo shape de ClinicRole (access master + ações).
model AgencyRole {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  permissions    Json
  canManageRoles Boolean @default(false)

  // Hierarquia LINEAR (igual ClinicRole). Menor level = mais alto. ADMIN titular
  // está acima de todos os cargos (tratado em código como acima de qualquer level).
  level Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[] @relation("UserAgencyRole")

  @@unique([organizationId, name])
  @@unique([organizationId, level])
  @@index([organizationId])
}

model ClinicHoliday {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      String // "YYYY-MM-DD"
  name      String
  createdAt DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId])
}

// =====================================================
// PIPELINE INTERNO DA CLÍNICA
// =====================================================

// Tipo de funil. As duas pipelines "nativas" da clínica têm semântica fixa:
// COMMERCIAL (Lead→Agendado→Compareceu→Fechado→No-show, etapas com função de
// negócio) e RETENTION (Ativo/Inativo por inatividade). CUSTOM = funis livres
// que a clínica cria (sem etapas com função). Máx. 6 pipelines por clínica.
enum PipelineKind {
  COMMERCIAL // funil comercial padrão (antigo StageKind.NEW)
  RETENTION // funil de retenção (antigo StageKind.EXISTING)
  CUSTOM // funil livre criado pela clínica
}

// Identidade ESTÁVEL da função de uma etapa nativa (Fase 2). O nome é renomeável
// e isWon/isLost só cobrem 2 das 5; o código decide o efeito de negócio do drag
// por este campo, não pelo nome. Cadeia COMMERCIAL: LEAD<SCHEDULED<ATTENDED<CLOSED
// (NO_SHOW é desfecho fora da cadeia). RETENTION: ACTIVE/INACTIVE. null = etapa
// livre (sem efeito).
enum StageNativeKey {
  LEAD
  SCHEDULED
  ATTENDED
  CLOSED
  NO_SHOW
  ACTIVE
  INACTIVE
}

// Um funil da clínica. Substitui o antigo `StageKind` em PipelineStage: agora
// uma clínica tem N pipelines (≤6) em vez de dois funis fixos. As duas nativas
// (COMMERCIAL/RETENTION) nascem com a clínica e não podem ser excluídas.
model Pipeline {
  id             String       @id @default(cuid())
  organizationId String // desnormalizado (invariante == client.organizationId)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  name           String
  kind           PipelineKind @default(CUSTOM)
  order          Int // posição entre as abas da clínica
  createdAt      DateTime     @default(now())

  // Dono da pipeline (item 4 — pipelines pessoais). Escalar sem FK, igual a
  // Lead.assignedToId. NATIVAS (Comercial/Retenção) têm ownerId NULL = estrutura
  // compartilhada (todos enxergam as etapas; os CARDS é que filtram por dono).
  // Pipelines EXTRAS criadas por um usuário gravam ownerId = criador → só o dono
  // (e quem tem crm:viewAll/titular) as vê.
  ownerId String?

  stages PipelineStage[]

  @@unique([clientId, order])
  @@index([clientId])
  @@index([organizationId, clientId])
  @@index([clientId, ownerId])
}

model PipelineStage {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  // `order` é único dentro de cada pipeline, não entre elas.
  order     Int
  color     String?
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  // Etapa nativa de pipeline nativa: não pode ser excluída pelo usuário
  // (recebe função de negócio: agenda/financeiro/KPI). Etapas livres = false.
  isNative  Boolean  @default(false)
  // Função estável da etapa nativa (Fase 2). null = etapa livre, sem efeito.
  nativeKey StageNativeKey?
  createdAt DateTime @default(now())

  leads Lead[]

  @@unique([pipelineId, order])
  @@index([clientId])
  @@index([pipelineId])
}

enum LeadSource {
  META_ADS
  GOOGLE_ADS
  ORGANIC
  REFERRAL
  WHATSAPP
  WALK_IN
  OTHER
}

model MarketingCampaign {
  id        String     @id @default(cuid())
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id])
  name      String
  source    LeadSource
  budget    Decimal?   @db.Decimal(12, 2)
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean    @default(true)
  notes     String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  leads Lead[]
  costs Cost[]

  @@index([clientId, isActive])
}

model Lead {
  id             String @id @default(cuid())
  organizationId String
  clientId       String
  client         Client @relation(fields: [clientId], references: [id])

  name              String
  phone             String?
  email             String?
  source            LeadSource
  campaignId        String?
  campaign          MarketingCampaign? @relation(fields: [campaignId], references: [id])
  // Rótulo livre dos procedimentos de interesse (nomes concatenados) — mantido
  // para exibição/compat. A lista estruturada vive em `procedureInterestIds`.
  procedureInterest String?
  // Procedimentos de interesse (ids de Procedure). Permite >1 e alimenta o
  // "valor estimado" (soma dos preços) na criação do lead.
  procedureInterestIds String[] @default([])
  notes             String?            @db.Text

  stageId  String
  stage    PipelineStage @relation(fields: [stageId], references: [id])
  // Posição manual dentro da coluna. Float fracionário permite inserir entre
  // dois cards sem renumerar (1.0 → 1.5 → 2.0). Mesmo padrão do PipelineDeal.
  position Float         @default(0)

  firstContactAt DateTime?
  scheduledAt    DateTime?
  attendedAt     DateTime?
  closedAt       DateTime?
  lostAt         DateTime?
  lostReason     String?

  patientId      String?
  patient        Patient? @relation(fields: [patientId], references: [id])
  estimatedValue Decimal? @db.Decimal(12, 2)

  // Agendamento gerado quando o card entra em SCHEDULED (Fase 2). Usado pelo
  // Fechado (verificar/baixar) e pelo retrocesso (desfazer). 1:1 com Appointment.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  assignedToId String?
  tags         String[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  interactions LeadInteraction[]
  activities   Activity[]
  clientNotes  ClientNote[]
  documents    Document[]

  @@index([organizationId, clientId])
  @@index([clientId, stageId, deletedAt])
  @@index([clientId, stageId, position])
  @@index([clientId, source])
  @@index([clientId, createdAt])
}

model LeadInteraction {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String
  content     String   @db.Text
  metadata    Json?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([leadId, createdAt])
}

// =====================================================
// PACIENTES
// =====================================================

model Patient {
  id             String @id @default(cuid())
  organizationId String
  clientId       String
  client         Client @relation(fields: [clientId], references: [id])

  name      String
  phone     String?
  email     String?
  birthDate DateTime?
  cpf       String?
  notes     String?   @db.Text
  tags      String[]

  // true = registro criado automaticamente ao AGENDAR um lead (pode nunca ter
  // comparecido). A lista de Pacientes só mostra "pacientes reais": ou este flag
  // é false (cadastro manual / ganho) ou existe ≥1 Appointment ATTENDED. Evita
  // que no-shows/cancelamentos virem "pacientes fantasmas" na aba.
  fromScheduledLead Boolean @default(false)

  firstVisitAt DateTime?
  lastVisitAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  leads        Lead[]
  appointments Appointment[]
  revenues     Revenue[]
  activities   Activity[]
  clientNotes  ClientNote[]
  documents    Document[]

  @@index([organizationId, clientId])
  @@index([clientId, deletedAt])
}

// =====================================================
// PROCEDIMENTOS
// =====================================================

model ProcedureCategory {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  name      String
  color     String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  procedures Procedure[]

  @@unique([clientId, name])
  @@index([clientId])
}

model Procedure {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id])
  categoryId     String?
  category       ProcedureCategory? @relation(fields: [categoryId], references: [id])

  name            String
  description     String? @db.Text
  price           Decimal @db.Decimal(12, 2)
  cost            Decimal @db.Decimal(12, 2)
  durationMinutes Int?
  isActive        Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  appointments      Appointment[]
  revenues          Revenue[]
  revenueProcedures RevenueProcedure[]

  @@index([organizationId, clientId])
  @@index([clientId, isActive])
}

// =====================================================
// AGENDAMENTOS
// =====================================================

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELED
  RESCHEDULED
}

model Appointment {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id])
  procedureId    String
  procedure      Procedure @relation(fields: [procedureId], references: [id])

  scheduledAt     DateTime
  durationMinutes Int
  status          AppointmentStatus @default(SCHEDULED)
  confirmedAt     DateTime?
  attendedAt      DateTime?
  noShowAt        DateTime?
  canceledAt      DateTime?
  cancelReason    String?

  notes String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  // Dono/responsável do agendamento (item 4 — agenda pessoal). Escalar sem FK
  // (igual Lead.assignedToId). Default = criador; reatribuível. Quem não tem
  // appointments:viewAll/titular só vê os próprios.
  assignedToId String?
  deletedAt   DateTime?

  revenue Revenue?
  lead    Lead? // card do CRM que gerou este agendamento (Fase 2)

  @@index([organizationId, clientId])
  @@index([clientId, scheduledAt])
  @@index([clientId, status])
  @@index([clientId, assignedToId])
}

// =====================================================
// FINANCEIRO
// =====================================================

// Regime tributário (Client.taxRegime) — DRE.
enum TaxRegime {
  SIMPLES
  PRESUMIDO
  REAL
}

// Categoria da receita p/ o split da receita bruta na DRE. FINANCEIRA NÃO entra na
// receita bruta operacional — alimenta `receitasFinanceiras` (resultado financeiro).
enum RevenueType {
  PROCEDIMENTO
  PACOTE
  RECORRENCIA
  PRODUTO
  OUTRA
  FINANCEIRA
}

// Estado da venda (faturamento). Competência: a receita é reconhecida na `date`.
// ABERTA = faturada com parcelas a receber; QUITADA = todas as parcelas pagas;
// CANCELADA = venda cancelada (vira dedução `cancelamentos` no período do cancelamento).
enum RevenueStatus {
  ABERTA
  QUITADA
  CANCELADA
}

// Parcela de contas a receber. PERDIDO = baixa (write-off) → dedução `inadimplencia`.
enum ReceivableStatus {
  PENDENTE
  PAGO
  PERDIDO
  CANCELADO
}

// Ativo imobilizado (TANGÍVEL → depreciação) ou intangível (→ amortização).
enum AssetKind {
  TANGIVEL
  INTANGIVEL
}

enum DepreciationMethod {
  LINEAR
}

// Tipo de custo, alinhado aos buckets da DRE (ledger dre-progresso.md). Os tipos
// foram expandidos p/ a DRE: imposto separa sobre-receita × sobre-lucro; comissão,
// comercial, administrativa e despesa financeira viraram tipos próprios. `TAX`
// antigo foi renomeado p/ `TAX_REVENUE` na migration. CSP = VARIABLE(category
// PROCEDURE_COST) + COMMISSION; OPEX = MARKETING + COMMERCIAL + (ADMINISTRATIVE +
// PAYROLL + FIXED); financeiro = FINANCIAL_EXPENSE.
enum CostType {
  FIXED
  VARIABLE
  MARKETING
  PAYROLL
  TAX_REVENUE
  TAX_PROFIT
  COMMISSION
  COMMERCIAL
  ADMINISTRATIVE
  FINANCIAL_EXPENSE
  OTHER
}

model Revenue {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])
  patientId      String?
  patient        Patient?     @relation(fields: [patientId], references: [id])
  procedureId    String?
  procedure      Procedure?   @relation(fields: [procedureId], references: [id])
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])

  // DRE/competência: `grossAmount` = receita bruta faturada; `discount` = desconto
  // concedido; `amount` = líquido reconhecido (grossAmount - discount), na `date`
  // (data de competência). O recebimento é rastreado nas parcelas (`receivables`).
  type          RevenueType   @default(OUTRA)
  grossAmount   Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  amount        Decimal       @db.Decimal(12, 2)
  status        RevenueStatus @default(ABERTA)
  date          DateTime
  description   String?
  paymentMethod String?
  installments  Int?          @default(1)
  canceledAt    DateTime?
  cancelReason  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  procedures  RevenueProcedure[]
  costs       Cost[]
  receivables Receivable[]

  @@index([organizationId, clientId])
  @@index([clientId, date])
  @@index([clientId, status])
}

// Itens de procedimento de uma receita. Permite múltiplos procedimentos por
// receita; `price`/`cost` são snapshots no momento do lançamento.
model RevenueProcedure {
  id          String    @id @default(cuid())
  // clientId presente p/ a policy de RLS tenant_isolation (filtra por clientId).
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  revenueId   String
  revenue     Revenue   @relation(fields: [revenueId], references: [id], onDelete: Cascade)
  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id])

  price Decimal @db.Decimal(12, 2)
  cost  Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([revenueId])
  @@index([procedureId])
  @@index([clientId])
}

model Cost {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id])
  campaignId     String?
  campaign       MarketingCampaign? @relation(fields: [campaignId], references: [id])
  // Custo gerado automaticamente a partir de um procedimento de receita.
  revenueId      String?
  revenue        Revenue?           @relation(fields: [revenueId], references: [id], onDelete: SetNull)

  type         CostType
  category     String?
  amount       Decimal  @db.Decimal(12, 2)
  date         DateTime
  description  String?
  isRecurring  Boolean  @default(false)
  recurringDay Int?

  // Self-relation: instances generated from a recurring template point back to it.
  // null on templates and on standalone costs; set on auto-generated children.
  recurringSourceId  String?
  recurringSource    Cost?   @relation("RecurringInstances", fields: [recurringSourceId], references: [id], onDelete: SetNull)
  recurringInstances Cost[]  @relation("RecurringInstances")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  @@index([organizationId, clientId])
  @@index([clientId, date])
  @@index([clientId, type])
  @@index([recurringSourceId, date])
  @@index([revenueId])
}

// Conta a receber (parcela de uma Revenue). Competência: a receita é reconhecida na
// venda; o RECEBIMENTO vive aqui. Caixa = parcelas PAGO por `paidAt`. Inadimplência =
// parcela vencida não paga (aging); vira dedução da DRE quando baixada (PERDIDO).
// Tem `clientId` → entra na RLS (migration). Ver dre-progresso.md.
model Receivable {
  id             String           @id @default(cuid())
  organizationId String
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id])
  revenueId      String
  revenue        Revenue          @relation(fields: [revenueId], references: [id], onDelete: Cascade)

  installmentNumber Int
  amount            Decimal          @db.Decimal(12, 2)
  dueDate           DateTime
  status            ReceivableStatus @default(PENDENTE)
  paidAt            DateTime?
  paymentMethod     String?
  // Data da baixa por perda (write-off). Setada ao virar PERDIDO, limpa ao reverter.
  // A DRE usa este campo (não `updatedAt`) p/ atribuir a inadimplência ao período.
  writtenOffAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, dueDate])
  @@index([clientId, status])
  @@index([revenueId])
}

// Ativo imobilizado/intangível (DRE — módulo de ativos). Depreciação/amortização
// calculada por período (linear) em `services/dre/depreciation.ts`. Tem `clientId`
// → entra na RLS (migration).
model FixedAsset {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id])

  name             String
  category         String?
  kind             AssetKind          @default(TANGIVEL)
  acquisitionValue Decimal            @db.Decimal(12, 2)
  residualValue    Decimal            @default(0) @db.Decimal(12, 2)
  acquisitionDate  DateTime
  usefulLifeMonths Int
  method           DepreciationMethod @default(LINEAR)
  disposedAt       DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  @@index([clientId])
}

// =====================================================
// METAS
// =====================================================

enum GoalMetric {
  REVENUE
  LEADS
  CONVERSION_RATE
  NO_SHOW_RATE
  AVERAGE_TICKET
  APPOINTMENTS
  NEW_PATIENTS
}

enum GoalPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

// Escopo de uma meta (Etapa 2). CLINIC = coletiva da clínica (legado: toda meta
// antiga vira CLINIC no backfill). USER = atribuída a um usuário. ROLE =
// atribuída a um cargo (ClinicRole) — expande em uma meta por membro na UI.
enum GoalScopeType {
  CLINIC
  USER
  ROLE
}

// Modo só importa para USER/ROLE. INDIVIDUAL = cada pessoa tem sua cota e o
// progresso é medido pelo que cada um gerou (autor do registro). SHARED = a
// meta é do grupo (soma de todos contra um alvo único). CLINIC é sempre SHARED.
enum GoalMode {
  INDIVIDUAL
  SHARED
}

model Goal {
  id             String @id @default(cuid())
  organizationId String
  clientId       String
  client         Client @relation(fields: [clientId], references: [id])

  metric      GoalMetric
  period      GoalPeriod
  targetValue Decimal    @db.Decimal(15, 2)
  startDate   DateTime
  endDate     DateTime
  notes       String?

  // Escopo (Etapa 2). Default CLINIC para compatibilidade com metas existentes.
  scopeType      GoalScopeType @default(CLINIC)
  mode           GoalMode      @default(SHARED)
  assigneeUserId String?
  assigneeUser   User?         @relation("GoalAssignee", fields: [assigneeUserId], references: [id], onDelete: Cascade)
  assigneeRoleId String?
  assigneeRole   ClinicRole?   @relation("GoalRoleAssignee", fields: [assigneeRoleId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId, metric, period])
  @@index([clientId, assigneeUserId])
  @@index([clientId, assigneeRoleId])
}

// =====================================================
// INSIGHTS
// =====================================================

enum InsightSeverity {
  INFO
  WARNING
  CRITICAL
}

enum InsightCategory {
  COMMERCIAL
  FINANCIAL
  OPERATIONAL
  RETENTION
  MARKETING
}

enum InsightStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

model Insight {
  id             String @id @default(cuid())
  organizationId String
  clientId       String
  client         Client @relation(fields: [clientId], references: [id])

  ruleKey  String
  category InsightCategory
  severity InsightSeverity
  status   InsightStatus   @default(OPEN)

  title           String
  diagnosis       String   @db.Text
  estimatedImpact Decimal? @db.Decimal(12, 2)
  suggestion      String   @db.Text
  metadata        Json?

  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  dismissedAt    DateTime?
  dismissReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([clientId, severity])
  @@index([clientId, createdAt])
}

// =====================================================
// ATIVIDADES E TAREFAS
// =====================================================

// Domínio dono da atividade (reforma divisão total). ADMIN = atividade da
// agência (pode ter clientId só como ETIQUETA de CRM, "relacionada à clínica
// X"). CLINIC = atividade operacional criada pela própria clínica (clientId =
// dono). O discriminador impede que a tarefa da clínica apareça no painel do
// admin e vice-versa — clientId sozinho não distingue os dois usos.
enum ActivityDomain {
  ADMIN
  CLINIC
}

enum ActivityType {
  TASK
  MEETING
  CALL
  EMAIL
  NOTE
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Activity {
  id             String         @id @default(cuid())
  organizationId String
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  // ADMIN por padrão (toda atividade existente é da agência). Clínica grava
  // CLINIC. Queries de cada domínio filtram por este campo — ver §3.4.
  domain         ActivityDomain @default(ADMIN)

  title       String
  description String?          @db.Text
  type        ActivityType
  status      ActivityStatus   @default(PENDING)
  priority    ActivityPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?

  assignedToId String?
  assignedTo   User?   @relation("AssignedActivities", fields: [assignedToId], references: [id])

  // Alvo da atividade (item 1 — atividade orientada a cliente). Atividade de
  // CLÍNICA exige EXATAMENTE um de leadId/patientId (app-enforced na action);
  // atividade de AGÊNCIA (domain ADMIN) não usa nenhum. O card de paciente
  // mostra as atividades do patientId E dos leads ligados (continuidade
  // lead→paciente sem precisar migrar a FK na conversão).
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?
  createdBy        User?     @relation("CreatedActivities", fields: [createdById], references: [id])
  seenByAssigneeAt DateTime?
  // Id compartilhado por todas as cópias geradas em um fan-out "Todos".
  // Usado pelo admin para colapsar as N cópias em uma única linha na pasta
  // "Todos" (mostra apenas a cópia do próprio admin).
  broadcastId      String?
  deletedAt        DateTime?

  // Evento ligado no calendário pessoal do responsável — quando a atividade
  // é criada com "Adicionar ao calendário". Edit/delete da atividade
  // sincroniza com o evento (handled na camada de actions).
  calendarEvent CalendarEvent?

  @@index([organizationId, status])
  @@index([assignedToId, status])
  @@index([dueDate])
  @@index([organizationId, status, dueDate])
  // Domínio clínica: queries escopam por clientId. Cobre where+orderBy reais
  // das listagens de atividade da clínica (Fase 3 da reforma divisão total).
  @@index([clientId, status, dueDate])
  @@index([broadcastId])
  // Item 1: atividades do card de um lead/paciente.
  @@index([leadId])
  @@index([patientId])
}

// Anotação livre do CARD do cliente (item 6). Orientada a lead/paciente como a
// Activity, mas sem prazo/status — é só texto datado e autorado. Paciente vê as
// anotações dele E dos leads ligados (mesma continuidade da Activity).
model ClientNote {
  id             String  @id @default(cuid())
  organizationId String
  clientId       String
  client         Client  @relation(fields: [clientId], references: [id])
  leadId         String?
  lead           Lead?   @relation(fields: [leadId], references: [id])
  patientId      String?
  patient        Patient? @relation(fields: [patientId], references: [id])

  authorId String?
  author   User?   @relation("AuthoredNotes", fields: [authorId], references: [id])

  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId, leadId])
  @@index([clientId, patientId])
}

// Documento/arquivo do CARD do cliente (item 6c). Dado sensível de saúde (LGPD):
// o BINÁRIO vive num bucket PRIVADO do Supabase Storage (criptografia em repouso
// do Supabase); aqui guardamos só os METADADOS + a chave (`storagePath`). Acesso
// ao arquivo sempre por URL assinada de curta duração. Orientado a lead/paciente.
model Document {
  id             String  @id @default(cuid())
  organizationId String
  clientId       String
  client         Client  @relation(fields: [clientId], references: [id])
  leadId         String?
  lead           Lead?   @relation(fields: [leadId], references: [id])
  patientId      String?
  patient        Patient? @relation(fields: [patientId], references: [id])

  uploaderId String?
  uploader   User?   @relation("UploadedDocuments", fields: [uploaderId], references: [id])

  fileName    String
  mimeType    String
  sizeBytes   Int
  // Chave do objeto no bucket privado (ex.: "<clientId>/<id>/<fileName>").
  storagePath String

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([clientId, leadId])
  @@index([clientId, patientId])
}

// =====================================================
// CALENDÁRIO PESSOAL (por usuário)
// =====================================================

model CalendarEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  // Escopo de domínio (reforma divisão total, Fase 1). Evento da clínica recebe
  // o clientId do dono; evento de agência fica null. Derivar domínio:
  // clientId != null ⇒ clínica. Garantido por ClinicContext na camada de dados.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  title    String
  startAt  DateTime
  endAt    DateTime?
  notes    String?   @db.Text
  // Opcionais: cor (hex) e categoria livre (ex.: "Pessoal", "Reunião") para
  // visualização. Não afetam o filtro/permissão.
  color    String?
  category String?

  // Atividade que originou esse evento (sync 1:1). null para eventos criados
  // direto no calendário. Edit/delete da atividade propaga via actions.
  activityId String?   @unique
  activity   Activity? @relation(fields: [activityId], references: [id])

  // Série recorrente (item 7). Eventos gerados juntos (ex.: "todo dia 9") dividem
  // este id — permite excluir a série inteira de uma vez. null = evento avulso.
  recurrenceGroupId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, startAt])
  @@index([organizationId, deletedAt])
  @@index([clientId, startAt])
  @@index([recurrenceGroupId])
}

model OrgHoliday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  date           String // YYYY-MM-DD (sem TZ — feriado é dia inteiro)
  name           String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, date])
  @@index([organizationId])
}

// =====================================================
// PIPELINE DO ADMIN
// =====================================================

enum DealStage {
  PROSPECT
  CONTACTED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

model PipelineDeal {
  id             String @id @default(cuid())
  organizationId String
  clientId       String
  client         Client @relation(fields: [clientId], references: [id])

  stage           DealStage @default(PROSPECT)
  // Posição manual dentro da coluna. Usa Float fracionário para permitir
  // inserir entre dois cards sem renumerar tudo (ex.: entre 1.0 e 2.0 → 1.5).
  position        Float     @default(0)
  value           Decimal?  @db.Decimal(12, 2)
  probability     Int?
  expectedCloseAt DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  lostReason      String?
  notes           String?   @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Uma única negociação ativa por clínica é garantida via índice único
  // parcial (`WHERE "deletedAt" IS NULL`) criado em migration — Prisma não
  // expressa partial unique no DSL. Soft-deletes da mesma clínica podem
  // coexistir; o app-level check em createPipelineDealAction valida o resto.
  @@index([organizationId, stage])
  @@index([organizationId, stage, position])
}

// =====================================================
// SNAPSHOTS DE KPI
// =====================================================

model KpiSnapshot {
  id             String @id @default(cuid())
  organizationId String
  clientId       String
  client         Client @relation(fields: [clientId], references: [id])

  periodType  String
  periodStart DateTime
  periodEnd   DateTime

  leadsCount            Int      @default(0)
  appointmentsCount     Int      @default(0)
  attendedCount         Int      @default(0)
  noShowCount           Int      @default(0)
  conversionRate        Decimal? @db.Decimal(5, 4)
  noShowRate            Decimal? @db.Decimal(5, 4)
  avgTimeToFirstContact Int?

  totalRevenue  Decimal  @default(0) @db.Decimal(15, 2)
  totalCosts    Decimal  @default(0) @db.Decimal(15, 2)
  grossMargin   Decimal? @db.Decimal(5, 4)
  netMargin     Decimal? @db.Decimal(5, 4)
  averageTicket Decimal? @db.Decimal(12, 2)
  marketingCost Decimal  @default(0) @db.Decimal(15, 2)
  roi           Decimal? @db.Decimal(8, 4)
  cac           Decimal? @db.Decimal(12, 2)

  healthScore Int?

  computedAt DateTime @default(now())

  @@unique([clientId, periodType, periodStart])
  @@index([organizationId, periodType, periodStart])
}

// =====================================================
// NOTIFICAÇÕES
// =====================================================

enum NotificationType {
  INSIGHT_GENERATED
  GOAL_AT_RISK
  GOAL_ACHIEVED
  ACTIVITY_DUE
  ACTIVITY_OVERDUE
  CLIENT_INACTIVE
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Escopo de domínio (reforma divisão total, Fase 1). Preenchido quando o
  // destinatário é de clínica (= User.clientId do destinatário); null para
  // notificação de agência. Derivar domínio: clientId != null ⇒ clínica.
  clientId  String?
  client    Client?          @relation(fields: [clientId], references: [id])
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([clientId, readAt])
}

// =====================================================
// AUDIT LOG
// =====================================================

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  action         String
  entityType     String
  entityId       String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId])
}

// Rate-limit (seguranca-pendencias #1) — contador fixed-window persistido no
// Postgres. Infra GLOBAL, SEM `clientId` → fica FORA da RLS de propósito: o login
// (NextAuth `authorize`) e o webhook rodam sem escopo de clínica e precisam
// escrever aqui. `key` = `${bucket}:${identifier}` (ex.: `login:ip:<ip>` /
// `webhook:client:<id>`). A janela reseta quando `expiresAt` passa.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
